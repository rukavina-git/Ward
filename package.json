{
  "name": "ward-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/analyzers",
    "packages/report",
    "packages/ingest",
    "packages/mcp",
    "evals"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run build",
    "test": "vitest run",
    "eval:run": "npm run -s build -w @ward/core -w @ward/analyzers -w @ward/report -w @ward/mcp -w @ward/evals && node evals/dist/run-cli.js",
    "eval:score": "npm run -s build -w @ward/evals && node evals/dist/score-cli.js",
    "eval:recheck": "npm run -s build -w @ward/core -w @ward/report -w @ward/evals && node evals/dist/recheck-cli.js",
    "eval:summary": "npm run -s build -w @ward/evals && node evals/dist/summary-cli.js",
    "eval:retrieval": "npm run -s build -w @ward/core -w @ward/ingest -w @ward/evals && node evals/dist/retrieval-cli.js",
    "eval:tune-bm25": "npm run -s build -w @ward/core -w @ward/evals && node evals/dist/tune-bm25-cli.js",
    "ingest": "npm run -s build -w @ward/core -w @ward/ingest && node packages/ingest/dist/cli.js",
    "embed": "npm run -s build -w @ward/core -w @ward/ingest && node packages/ingest/dist/embed-cli.js",
    "eval:tune-hybrid": "npm run -s build -w @ward/core -w @ward/ingest -w @ward/evals && node evals/dist/tune-hybrid-cli.js",
    "eval:compare": "npm run -s build -w @ward/evals && node evals/dist/compare-cli.js",
    "heldout:check": "npm run -s build -w @ward/core -w @ward/evals && node evals/dist/held-out-check-cli.js",
    "eval:score-heldout": "npm run -s build -w @ward/core -w @ward/evals && node evals/dist/held-out-score-cli.js",
    "prompts:sync": "cp prompts/ward-check/SKILL.md plugin/skills/check/SKILL.md",
    "plugin:build": "node scripts/build-plugin.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
