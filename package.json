{
  "name": "ward-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "evals"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run build",
    "test": "vitest run",
    "eval:run": "npm run -s build -w @ward/evals && node evals/dist/run-cli.js",
    "eval:score": "npm run -s build -w @ward/evals && node evals/dist/score-cli.js",
    "eval:summary": "npm run -s build -w @ward/evals && node evals/dist/summary-cli.js",
    "eval:retrieval": "npm run -s build -w @ward/core -w @ward/evals && node evals/dist/retrieval-cli.js",
    "ingest": "npm run -s build -w @ward/core -w @ward/ingest && node packages/ingest/dist/cli.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
